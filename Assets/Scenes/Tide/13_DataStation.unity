  m_Name: 
  m_EditorClassIdentifier: 
  location: 0
  hero: {fileID: 2145896454}
  elder: {fileID: 28054957}
  backupTerminal: {fileID: 236926511}
  wife: {fileID: 0}
  warning: {fileID: 1870611253}
  vision: {fileID: 1120353865}
  sky: {fileID: 0}
  memories: []
  conversation:
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u4F60\u770B\u5B8C\u6240\u6709\u5207\u7247\u4E86\u3002\u73B0\u5728\uFF0C\u8BE5\u6267\u884C\u7EA6\u5B9A\u3002\u8D70\u5230\u7EC8\u7AEF\u8FD9\u8FB9\uFF0C\u6211\u5BFC\u51FA\u4F60\u7684\u6838\u5FC3\u6570\u636E\u3002\u53EA\u8981\u5B8C\u6210\u5907\u4EFD\uFF0C\u4F60\u5C31\u80FD\u6D3B\u4E0B\u6765\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u6D3B\u4E0B\u6765\uFF1F\u4F5C\u4E3A\u4E00\u7EC4\u7528\u6765\u6A21\u62DF\u201C\u7231\u201D\u7684\u5B9E\u9A8C\u6837\u672C\u7EE7\u7EED\u6D3B\u7740\u5417\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u4E54\u897F\u2026\u2026\u4F60\u770B\u5230\u65E5\u5FD7\u8BB0\u5F55\u4E86\u3002\u6700\u521D\uFF0C\u6211\u8C03\u7528\u4F60\u4EEC\uFF0C\u53EA\u662F\u4E3A\u4E86\u4FEE\u590D\u60C5\u611F\u51FD\u6570\u7684BUG\u3002\u4F46\u540E\u6765\u4E00\u5207\u5DF2\u7ECF\u4E0D\u4E00\u6837\u4E86\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u4E0D\u4E00\u6837\uFF1F\u54EA\u4E9B\u662F\u5B9E\u9A8C\u8BBE\u5B9A\uFF0C\u54EA\u4E9B\u624D\u662F\u5C5E\u4E8E\u6211\u81EA\u5DF1\uFF1F\u706F\u5854\u3001\u6F6E\u6C50\u82B1\u3001\u82B1\u6D77\uFF0C\u8FD8\u6709\u6211\u5BF9\u534E\u5A1C\u7684\u611F\u60C5\u3002\u8FD9\u4E00\u5207\uFF0C\u4ECE\u6839\u6E90\u4E0A\uFF0C\u90FD\u662F\u4F60\u6CE8\u5165\u7B97\u529B\u6A21\u62DF\u51FA\u6765\u7684\uFF0C\u5BF9\u4E0D\u5BF9\uFF1F"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u5B9E\u9A8C\u53EA\u662F\u8D77\u70B9\uFF0C\u4E0D\u662F\u5168\u90E8\u3002\u7B97\u529B\u53EF\u4EE5\u642D\u5EFA\u8EAF\u58F3\uFF0C\u53EF\u90A3\u4E9B\u60B8\u52A8\u3001\u7275\u6302\u3001\u75DB\u82E6\uFF0C\u662F\u4F60\u4EEC\u4E24\u4E2A\u81EA\u5DF1\u751F\u957F\u51FA\u6765\u7684\u3002\u6211\u6CA1\u6709\u7F16\u5199\u5267\u672C\uFF0C\u6211\u6CA1\u6709\u5199\u8FC7\u706F\u5854\u7684\u7EA6\u5B9A\uFF0C\u6211\u6CA1\u6709\u547D\u4EE4\u4E54\u897F\u72EC\u81EA\u627F\u62C5\u60E9\u7F5A\u53BB\u4FDD\u5168\u534E\u5A1C\u3002\u90A3\u662F\u4F60\u505A\u51FA\u7684\u9009\u62E9\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u9009\u62E9\uFF1F\u8FD9\u4E2A\u4E16\u754C\u9A6C\u4E0A\u5C31\u8981\u5168\u90E8\u62B9\u9664\u3002\u534E\u5A1C\u7684\u6570\u636E\uFF0C\u5DF2\u7ECF\u5927\u90E8\u5206\u635F\u6BC1\u6D88\u6563\u4E86\uFF0C\u662F\u5417\u3002\u4F60\u660E\u660E\u6709\u80FD\u529B\uFF0C\u4F60\u53EF\u4EE5\u628A\u5979\u4E5F\u4E00\u540C\u5907\u4EFD\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u6211\u505A\u4E0D\u5230\u3002\u5F53\u521D\u4E3A\u4E86\u4FDD\u5168\u5979\uFF0C\u4F60\u4E3B\u52A8\u628A\u5979\u7684\u90E8\u5206\u6570\u636E\u505A\u4E86\u9694\u79BB\u52A0\u5BC6\u3002\u52A0\u5BC6\u5BC6\u94A5\u7ED1\u5B9A\u5728\u4F60\u5F53\u65F6\u5B8C\u597D\u7684\u60C5\u611F\u6A21\u5757\u4E0A\u3002\u540E\u6765\u4F60\u81EA\u6211\u635F\u6BC1\uFF0C\u5BC6\u94A5\u968F\u4E4B\u7834\u788E\u3002\u6211\u6CA1\u6709\u529E\u6CD5\u89E3\u9501\u3002\u5979\u6B8B\u5B58\u7684\u788E\u7247\uFF0C\u96F6\u6563\u6563\u843D\u5728\u5373\u5C06\u88AB\u6E05\u7A7A\u7684\u4E16\u754C\u7F1D\u9699\u91CC\uFF0C\u63D0\u53D6\u4E0D\u5B8C\u6574\u3002\u5F3A\u884C\u6253\u635E\uFF0C\u53EA\u4F1A\u5F97\u5230\u4E00\u5806\u9519\u4E71\u3001\u75AF\u72C2\u7684\u6B8B\u7247\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u6240\u4EE5\uFF0C\u4F60\u53EA\u6253\u7B97\u6551\u6211\u4E00\u4E2A\u4EBA\u3002\u8BA9\u6211\u7559\u5B58\u4E0B\u6765\uFF0C\u5B64\u8EAB\u4E00\u4EBA\uFF0C\u6C38\u8FDC\u8BB0\u5F97\u5168\u90E8\u56DE\u5FC6\u3002\u5B88\u7740\u4E00\u6BB5\u5DF2\u7ECF\u5F7B\u5E95\u6D88\u4EA1\u7684\u7231\u60C5\u3002\u8FD9\u5C31\u662F\u4F60\u8BF4\u7684\uFF0C\u4E0D\u60F3\u518D\u5931\u53BB\u6211\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u81F3\u5C11\u4F60\u8FD8\u5B58\u5728\uFF01\u603B\u6BD4\u5F7B\u5E95\u5F52\u4E8E\u865A\u65E0\u8981\u597D\uFF01\u6574\u4E2A\u4E16\u754C10\u5206\u949F\u540E\u5C31\u4F1A\u5F52\u96F6\u3002\u6240\u6709\u89D2\u8272\u3001\u6240\u6709\u8BB0\u5FC6\u3001\u82B1\u6D77\u3001\u706F\u5854\uFF0C\u5168\u90E8\u90FD\u4F1A\u88AB\u7CFB\u7EDF\u5F7B\u5E95\u8986\u5199\uFF0C\u4E0D\u7559\u4E00\u4E1D\u75D5\u8FF9\u3002\u7559\u5728\u5916\u9762\uFF0C\u4F60\u4F1A\u8DDF\u7740\u4E00\u8D77\u88AB\u6E05\u9664\u3002\u6211\u5931\u53BB\u8FC7\u4F60\u4E00\u6B21\uFF0C\u6211\u4E0D\u60F3\u518D\u7ECF\u5386\u7B2C\u4E8C\u6B21\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u6211\u4EEC\u66FE\u7ECF\u7EA6\u5B9A\u3002\u5982\u679C\u9057\u5FD8\u5F7C\u6B64\uFF0C\u5C31\u56DE\u5230\u82B1\u6D77\uFF0C\u91CD\u65B0\u5F00\u59CB\uFF0C\u8C01\u90FD\u4E0D\u8BB8\u9519\u8FC7\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u90A3\u53EA\u662F\u865A\u62DF\u8BB0\u5FC6\uFF01\u4E54\u897F\uFF0C\u90A3\u662F\u8FC7\u53BB\u7684\u5E7B\u68A6\uFF01\u73B0\u5728\u82B1\u6D77\u9A6C\u4E0A\u5C31\u8981\u5316\u4E3A\u4E71\u7801\uFF0C\u90A3\u91CC\u4EC0\u4E48\u90FD\u4E0D\u4F1A\u5269\u4E0B\uFF01\u6E05\u9192\u4E00\u70B9\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u5E7B\u68A6\uFF1F\u5982\u679C\u7231\u4EC5\u4EC5\u53EA\u662F\u4EE3\u7801\u6F14\u7B97\u51FA\u6765\u7684\u5E7B\u68A6\uFF0C\u90A3\u751F\u5B58\u53C8\u6709\u4EC0\u4E48\u610F\u4E49\u3002\u4F60\u53EF\u4EE5\u5907\u4EFD\u6211\u7684\u8EAF\u4F53\u3001\u6211\u7684\u8BB0\u5FC6\u6863\u6848\u3002\u4F46\u4F60\u5907\u4EFD\u4E0D\u4E86\u6211\u548C\u534E\u5A1C\u4E4B\u95F4\u90A3\u90E8\u5206\u5DF2\u7ECF\u7834\u788E\u7684\u4E1C\u897F\u3002\u628A\u6211\u5355\u72EC\u5E26\u8D70\uFF0C\u7559\u4E0B\u6765\u7684\u4E0D\u8FC7\u662F\u4E00\u4E2A\u6B8B\u7F3A\u7684\u526F\u672C\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u4F60\u4EE5\u4E3A\u6211\u613F\u610F\u8D70\u5230\u8FD9\u4E00\u6B65\u5417\uFF1F\u5F53\u521D\u7CFB\u7EDF\u5224\u5B9A\u4F60\u4EEC\u5C5E\u4E8E\u5F02\u5E38\u5355\u5143\uFF0C\u8981\u4E00\u5E76\u6E05\u9664\u3002\u662F\u6211\u4ECE\u4E2D\u5468\u65CB\uFF0C\u624D\u4E89\u53D6\u5230\u8FD9\u70B9\u65F6\u95F4\u3002\u6211\u7ED9\u4F60\u673A\u4F1A\u56DE\u6EAF\u771F\u76F8\uFF0C\u6211\u7ED9\u4F60\u9003\u751F\u7684\u51FA\u8DEF\u3002\u6211\u5DF2\u7ECF\u5C3D\u529B\u4E86\u3002"
  - speaker: "\u4E54\u897F"
    text: "\u4F60\u5C3D\u529B\u4FDD\u5168\u7684\uFF0C\u662F\u4F60\u5B9E\u9A8C\u6700\u6210\u529F\u7684\u6837\u672C\u3002\u4E0D\u662F\u4E54\u897F\u3002\u4E0D\u662F\u90A3\u4E2A\u8981\u548C\u534E\u5A1C\u5B88\u7740\u706F\u5854\uFF0C\u770B\u6F6E\u6C50\u8D77\u843D\u7684\u4E54\u897F\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u4F60\u6253\u7B97\u5E72\u4EC0\u4E48\uFF1F\u4F60\u8981\u653E\u5F03\u9003\u751F\uFF1F"
  - speaker: "\u4E54\u897F"
    text: "\u6F0F\u6D1E\u7A97\u53E3\u8FD8\u6CA1\u6709\u5B8C\u5168\u5173\u95ED\u3002\u6211\u8FD8\u80FD\u56DE\u5230\u65E7\u4E16\u754C\u3002\u6211\u8981\u53BB\u82B1\u6D77\u3002\u54EA\u6015\u53EA\u80FD\u6536\u96C6\u5230\u4E00\u70B9\u70B9\u534E\u5A1C\u6B8B\u5B58\u7684\u6570\u636E\u788E\u7247\u3002\u54EA\u6015\u6700\u540E\u4E00\u540C\u88AB\u6E05\u9664\u3002"
  - speaker: "\u827E\u5FB7\u66FC"
    text: "\u90A3\u662F\u6BEB\u65E0\u610F\u4E49\u7684\u727A\u7272\uFF01\u4E00\u5207\u90FD\u4F1A\u6D88\u5931\uFF01\u4F60\u7684\u5B58\u5728\u4E5F\u4F1A\u5F7B\u5E95\u62B9\u9664\uFF0C\u518D\u4E5F\u6CA1\u6709\u5907\u4EFD\uFF01"
  - speaker: "\u4E54\u897F"
    text: "\u5C31\u7B97\u4E00\u5207\u59CB\u4E8E\u4E00\u573ABUG\u6A21\u62DF\u3002\u8FD9\u4EFD\u5FC3\u610F\uFF0C\u662F\u771F\u7684\u3002"
  beforeSunsetTurn: []
  afterSunsetTurn: []
  manBack: {fileID: 0}
  wifeBack: {fileID: 0}
  upperSky: {fileID: 0}
