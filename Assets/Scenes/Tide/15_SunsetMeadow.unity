  warning: {fileID: 0}
  vision: {fileID: 0}
  meadowBackground: {fileID: 1676779677}
  memories: []
  conversation: []
  beforeSunsetTurn:
  - speaker: "\u534e\u5a1c"
    text: "\u4f60\u597d\u2026\u2026\u6211\u4eec\uff0c\u8ba4\u8bc6\u5417\uff1f"
  - speaker: "\u4e54\u897f"
    text: "\u4f60\u6216\u8bb8\u4e0d\u8bb0\u5f97\u6211\uff0c\u4f46\u4f60\u4e00\u5b9a\u8bb0\u5f97\u6f6e\u6c50\u82b1\u3002"
  - speaker: "\u534e\u5a1c"
    text: "\u554a\u2026\u2026\u6f6e\u6c50\u82b1\uff1f"
  - speaker: "\u534e\u5a1c"
    text: "\u6211\u597d\u50cf\uff0c\u5f88\u559c\u6b22\u5b83\u3002"
  afterSunsetTurn:
  - speaker: "\u4e54\u897f"
    text: "\u662f\u554a\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u90a3\u4e00\u6735\u82b1\u91cc\uff0c\u6709\u7740\u4e00\u8f6e\u65e5\u51fa\uff0c\u4e00\u53f6\u6241\u821f\uff0c\u7ffb\u6d8c\u7684\u78a7\u6d77\uff0c\u5f15\u822a\u7684\u706f\u5854\uff0c\u8fd8\u6709\u6d77\u8fb9\u7684\u4e00\u95f4\u5c0f\u5c4b\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u4ece\u524d\u6709\u4e24\u4e2a\u4eba\uff0c\u5728\u90a3\u91cc\u76f8\u4f34\u4e86\u5f88\u4e45\u5f88\u4e45\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u66fe\u7ecf\uff0c\u4e54\u897f\u5bf9\u7740\u534e\u5a1c\u8bf4\u51fa\u90a3\u53e5\uff1a"
  - speaker: "\u4e54\u897f"
    text: "\u6211\u7231\u4f60\u3002"
  - speaker: "\u534e\u5a1c"
    text: "\u53ef\u662f\uff0c\u7231\u662f\u4ec0\u4e48\u5462?"
  - speaker: "\u4e54\u897f"
    text: "\u90a3\u65f6\u7684\u534e\u5a1c\u4e5f\u66fe\u7591\u60d1\uff1a\u7231\uff0c\u7a76\u7adf\u662f\u4ec0\u4e48\uff1f"
  - speaker: "\u4e54\u897f"
    text: "\u5982\u4eca\u7ad9\u5728\u6f6e\u6c50\u9000\u53bb\u7684\u5cb8\u8fb9\uff0c\u4e54\u897f\u7ec8\u4e8e\u6709\u4e86\u7b54\u6848\uff1a"
  - speaker: "\u4e54\u897f"
    text: "\u7231\uff0c\u5c31\u662f\u7528\u4f59\u751f\u53bb\u7422\u78e8\u4e00\u53e5\u559c\u6b22\u7684\u610f\u4e49\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u662f\u548c\u5f7c\u6b64\u521b\u9020\u5c81\u6708\uff0c"
  - speaker: "\u4e54\u897f"
    text: "\u662f\u4e00\u573a\u8de8\u8d8a\u5149\u9634\u7684\u6c42\u7d22\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u54ea\u6015\u8bb0\u5fc6\u88ab\u6f6e\u6c50\u51b2\u5237\u4e00\u7a7a\uff0c"
  - speaker: "\u4e54\u897f"
    text: "\u4e5f\u6c38\u8fdc\u4e3a\u5bf9\u65b9\u7559\u7740\u4e00\u7247\u82b1\u6d77\uff0c\u7b49\u5f85\u7740\u91cd\u9022\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u6f6e\u6765\u5fc6\u8d77\uff0c\u6f6e\u53bb\u4eba\u79bb\u3002"
  - speaker: "\u4e54\u897f"
    text: "\u8fd9\u4e00\u6b21\u6211\u4eec\u7ec8\u4e8e\u4e00\u8d77\u2014\u2014"
  manBack: {fileID: 21300000, guid: ebe700b5ecac27c4c8d259d5d3dae81e, type: 3}
  wifeBack: {fileID: 21300000, guid: e4474c6d983ee1b4c83e01e6fef04b2b, type: 3}
  finalTitle: {fileID: 21300000, guid: 1f965a08113656e4fb2c91cf44c1d55b, type: 3}
