  lines:
  - "\u4E54\u897F\uFF0C\u4F60\u89C9\u5F97\u8FD9\u4E9B\u82B1\u597D\u770B\u5417\uFF1F"
  - "\u6216\u8BB8\u5427\uFF0C\u5B83\u7684\u989C\u8272\u5F88\u4E30\u5BCC\uFF0C\u7B26\u5408\u666E\u904D\u8BA4\u77E5\u4E2D\u7684\u7F8E\u4E3D\u3002"
  - "\u4F60\u89C9\u5F97\u5B83\u50CF\u4EC0\u4E48?"
  - "\u50CF\u5F69\u8679\uFF0C\u50CF\u88C5\u6EE1\u7CD6\u679C\u7684\u7CD6\u679C\u7F50\uFF0C\u4E5F\u8BB8\u8FD8\u50CF\u4E00\u679A\u52CB\u7AE0\u2026\u2026"
  - "\u4F60\u80FD\u770B\u5230\u5927\u6D77\u7684\u6F6E\u6C50\u5417"
  - "\u5728\u516C\u56ED\u91CC\u5417?"
  - "\u4E0D\u5BF9\uFF0C\u4F60\u518D\u770B\uFF0C\u8FD9\u6735\u82B1\u4E2D\u2026\u2026"
  - "\u6211\u8BC6\u522B\u4E0D\u51FA\u6765\u3002"
  - "\u4E54\u897F!"
  - "\u5662\uFF0C\u6211\u770B\u5230\u4E86\uFF0C\u90A3\u662F\u4E00\u8F6E\u65E5\u51FA\uFF0C\u90A3\u662F\u4E00\u8258\u5C0F\u8239\uFF0C\u90A3\u662F\u6307\u5F15\u822A\u884C\u7684\u706F\u5854\u3002"
