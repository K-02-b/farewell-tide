    text: "\u60C5\u611F\u51FD\u6570\u8C03\u7528\u9519\u8BEF\u2026\u2026\u662F"
    cue: 0
  - speaker: "\u7ED3\u8BBA"
    text: "\u6211\u4E0D\u7406\u89E3\u4EC0\u4E48\u662F\u201C\u7231\u201D"
    cue: 0
  - speaker: "\u5206\u6790"
    text: "\u4E5F\u8BB8\u6211\u8BE5\u8C03\u7528\u7B97\u529B\u53BB\u6A21\u62DF\u3002"
    cue: 0
